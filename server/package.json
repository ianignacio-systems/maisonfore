{
  "name": "maisonfore-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MaisonFore server: the /api/v1 API over PostgreSQL (Supabase), using the tee-sheet engine and Maison core.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@maison/core": "0.1.0",
    "@maison/engine": "0.1.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
